---
// Componente de navegación para el sitio web de GameHub
---

<nav>
  <div class="nav-container">
    <div class="logo">
      <span class="logo-text">GameHub</span>
    </div>
    <ul class="nav">
      <li><a href="/">Inicio</a></li>
      <li><a href="/juegos">Juegos</a></li>
      <li><a href="/contacto">Contacto</a></li>
    </ul>
  </div>
</nav>

<style>
  nav {
    background: linear-gradient(90deg, #0a0a0a 0%, #1a1a1a 100%);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.5);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.5rem;
    font-weight: bold;
    color: #fff;
    padding: 15px 0;
  }

  .logo-icon {
    font-size: 2rem;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .logo-text {
    color: #f5f5f5;
  }

  .nav {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 5px;
  }

  .nav li {
    margin: 0;
  }

  .nav a {
    display: block;
    padding: 12px 24px;
    color: #eee;
    text-decoration: none;
    font-weight: 500;
    border-radius: 8px;
    transition: all 0.3s ease;
    position: relative;
  }

  .nav a::before {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 24px;
    right: 24px;
    height: 2px;
    background: #808080;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .nav a:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #f5f5f5;
  }

  .nav a:hover::before {
    transform: scaleX(1);
  }

  @media (max-width: 768px) {
    .nav-container {
      flex-direction: column;
      gap: 15px;
      padding: 15px 20px;
    }

    .nav {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .nav a {
      padding: 10px 16px;
      font-size: 0.95rem;
    }
  }
</style>
