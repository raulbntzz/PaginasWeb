---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import FeatureCard from '../components/FeatureCard';
import StatsCard from '../components/StatsCard';
---

<Layout title="EcoData Solutions">
    <Hero />

    <!-- Estadísticas visuales -->
    <div class="row g-4 mb-5">
      <div class="col-md-6 col-lg-3">
        <StatsCard value={24} label="Indicadores Activos" icon="📊" color="#0066CC" />
      </div>
      <div class="col-md-6 col-lg-3">
        <StatsCard value={4} label="Ámbitos" icon="🎯" color="#ed8936" />
      </div>
      <div class="col-md-6 col-lg-3">
        <StatsCard value={100} label="Sostenibilidad" icon="🌳" color="#48bb78" suffix="%" />
      </div>
      <div class="col-md-6 col-lg-3">
        <StatsCard value={95} label="Digitalización" icon="💻" color="#6c757d" suffix="%" />
      </div>
    </div>

    <!-- Características principales -->
    <div class="mb-5">
      <div class="text-center mb-4">
        <h2 class="display-6 fw-bold mb-2">Funcionalidades Principales</h2>
      </div>
      <div class="row g-4">
        <div class="col-md-6 col-lg-3">
          <FeatureCard icon="📊" title="Consulta de Indicadores" description="Visualización completa del listado de indicadores con opciones de filtrado." color="#0066CC" />
        </div>
        <div class="col-md-6 col-lg-3">
          <FeatureCard icon="⚙️" title="Gestión Completa" description="Creación, edición y eliminación de indicadores mediante formularios." color="#ed8936" />
        </div>
        <div class="col-md-6 col-lg-3">
          <FeatureCard icon="📈" title="Análisis y Resumen" description="Estadísticas y totales para facilitar la toma de decisiones." color="#48bb78" />
        </div>
        <div class="col-md-6 col-lg-3">
          <FeatureCard icon="📷" title="Galería Visual" description="Recursos visuales relacionados con sostenibilidad y digitalización." color="#6c757d" />
        </div>
      </div>
    </div>
</Layout>
