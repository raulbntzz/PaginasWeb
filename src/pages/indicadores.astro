---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { IndicadorApiService } from '../lib/api';
import type { Indicador } from '../lib/types';

let indicadores: Indicador[] = [];
let error = '';
let tipos: string[] = [];
let ambitos: string[] = [];

const url = new URL(Astro.request.url);

const success = url.searchParams.get('success');
const urlError = url.searchParams.get('error');
const tipoFiltro = url.searchParams.get('tipo') || '';
const ambitoFiltro = url.searchParams.get('ambito') || '';

try {
  const todos = await IndicadorApiService.getAllAsync();
  tipos = [...new Set(todos.map(i => i.tipo))].sort();
  ambitos = [...new Set(todos.map(i => i.ambito))].sort();

  if (tipoFiltro && ambitoFiltro) {
    const porTipo = await IndicadorApiService.getByTipoAsync(tipoFiltro);
    indicadores = porTipo.filter(i =>
      i.ambito.toLowerCase().trim() === ambitoFiltro.toLowerCase().trim()
    );
  } else if (tipoFiltro) {
    indicadores = await IndicadorApiService.getByTipoAsync(tipoFiltro);
  } else if (ambitoFiltro) {
    indicadores = await IndicadorApiService.getByAmbitoAsync(ambitoFiltro);
  } else {
    indicadores = todos;
  }
} catch (e) {
  error = 'Error al conectar con la API. Asegúrate de que esté corriendo en http://localhost:5211';
  console.error(e);
}
---

<Layout title="Listado de Indicadores">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="h3 mb-0"><i class="fa-solid fa-arrow-up"></i>Listado de Indicadores</h2>
      <a href="/indicadores/crear" class="btn btn-primary">+ Crear Indicador</a>
    </div>

    {success === 'created' && (
      <div class="alert alert-success alert-dismissible fade show">
        <strong>Éxito:</strong> Indicador creado correctamente
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    )}

    {success === 'updated' && (
      <div class="alert alert-success alert-dismissible fade show">
        <strong>Éxito:</strong> Indicador actualizado correctamente
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    )}

    {success === 'deleted' && (
      <div class="alert alert-success alert-dismissible fade show">
        <strong>Éxito:</strong> Indicador eliminado correctamente
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    )}

    {urlError === 'not-found' && (
      <div class="alert alert-danger alert-dismissible fade show">
        <strong>Error:</strong> No se encontró el indicador solicitado
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    )}

    {error && (
      <div class="alert alert-danger alert-dismissible fade show">
        <strong>Error:</strong> {error}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    )}

    {!error && (
      <div class="card mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h5 mb-0">Filtros</h3>
            <span class="badge" style="font-size: 1rem; padding: 8px 16px; background: #0d6efd; color: white;">
              Indicadores encontrados: {indicadores.length}
            </span>
          </div>

          <form method="get" action="/indicadores" class="row g-3">
            <div class="col-md-4">
              <label for="tipo" class="form-label">Filtrar por Tipo:</label>
              <select name="tipo" id="tipo" class="form-select">
                <option value="">Todos los tipos</option>
                {tipos.map(tipo => {
                  const value = tipo.toLowerCase().trim();
                  return (
                    <option value={value} selected={value === tipoFiltro.toLowerCase().trim()}>
                      {tipo}
                    </option>
                  );
                })}
              </select>
            </div>

            <div class="col-md-4">
              <label for="ambito" class="form-label">Filtrar por Ámbito:</label>
              <select name="ambito" id="ambito" class="form-select">
                <option value="">Todos los ámbitos</option>
                {ambitos.map(ambito => {
                  const value = ambito.toLowerCase().trim();
                  return (
                    <option value={value} selected={value === ambitoFiltro.toLowerCase().trim()}>
                      {ambito}
                    </option>
                  );
                })}
              </select>
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">
              <button type="submit" class="btn btn-primary flex-grow-1">Aplicar</button>
              <a href="/indicadores" class="btn btn-secondary flex-grow-1">Limpiar</a>
            </div>
          </form>
        </div>
      </div>
    )}

    {!error && indicadores.length > 0 && (
      <div class="card">
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Tipo</th>
                  <th>Categoría</th>
                  <th>Nombre</th>
                  <th>Valor</th>
                  <th>Unidad</th>
                  <th>Fecha</th>
                  <th>Ámbito</th>
                  <th>Acciones</th>
                </tr>
              </thead>

              <tbody>
                {indicadores.map(indicador => (
                  <tr>
                    <td>{indicador.id}</td>
                    <td><span class="badge bg-primary">{indicador.tipo}</span></td>
                    <td>{indicador.categoria}</td>
                    <td><strong>{indicador.nombre}</strong></td>
                    <td>{indicador.valor}</td>
                    <td><small class="text-muted">{indicador.unidad || '-'}</small></td>
                    <td><small>{new Date(indicador.fecha).toLocaleDateString('es-ES')}</small></td>
                    <td><span class="badge bg-secondary">{indicador.ambito}</span></td>
                    <td>
                      <div class="btn-group btn-group-sm">
                        <a href={`/indicadores/ver/${indicador.id}`} class="btn btn-outline-primary">Ver</a>
                        <a href={`/indicadores/editar/${indicador.id}`} class="btn btn-outline-secondary">Editar</a>
                        <a href={`/indicadores/eliminar/${indicador.id}`} class="btn btn-outline-danger">Eliminar</a>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>

            </table>
          </div>
        </div>
      </div>
    )}

    {!error && indicadores.length === 0 && (
      <div class="card">
        <div class="card-body text-center py-5">
          <p class="text-muted mb-3">No hay indicadores disponibles.</p>
          <a href="/indicadores/crear" class="btn btn-primary">Crear el primer indicador</a>
        </div>
      </div>
    )}
</Layout>