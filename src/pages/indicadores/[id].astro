---
import Layout from '../../layouts/Layout.astro';
import { IndicadorApiService } from '../../lib/api';

const { id } = Astro.params;

if (!id) {
	return Astro.redirect('/');
}

let indicador = null;
let error = '';

try {
	indicador = await IndicadorApiService.getByIdAsync(parseInt(id));
	
	if (!indicador) {
		return Astro.redirect('/indicadores?error=not-found');
	}
} catch (e) {
	console.error(e);
	error = 'Error al cargar el indicador. Verifica que la API esté corriendo.';
}
---

<Layout title={`Indicador #${id}`}>
	{error && (
		<div class="alert alert-error">
			{error}
		</div>
	)}

	{indicador && (
		<div class="card">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
				<h2>Detalles del Indicador #{indicador.id}</h2>
				<div class="actions">
					<a href={`/indicadores/${indicador.id}/editar`} class="btn btn-secondary">Editar</a>
					<a href="/indicadores" class="btn btn-primary">Volver al listado</a>
				</div>
			</div>

			<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
				<div>
					<h3 style="margin-bottom: 0.5rem; color: #666; font-size: 0.875rem; text-transform: uppercase;">Tipo</h3>
					<p style="font-size: 1.125rem; margin-bottom: 1.5rem;">{indicador.tipo}</p>

					<h3 style="margin-bottom: 0.5rem; color: #666; font-size: 0.875rem; text-transform: uppercase;">Categoría</h3>
					<p style="font-size: 1.125rem; margin-bottom: 1.5rem;">{indicador.categoria}</p>

					<h3 style="margin-bottom: 0.5rem; color: #666; font-size: 0.875rem; text-transform: uppercase;">Nombre</h3>
					<p style="font-size: 1.125rem; margin-bottom: 1.5rem;">{indicador.nombre}</p>

					<h3 style="margin-bottom: 0.5rem; color: #666; font-size: 0.875rem; text-transform: uppercase;">Ámbito</h3>
					<p style="font-size: 1.125rem; margin-bottom: 1.5rem;">{indicador.ambito}</p>
				</div>

				<div>
					<h3 style="margin-bottom: 0.5rem; color: #666; font-size: 0.875rem; text-transform: uppercase;">Valor</h3>
					<p style="font-size: 1.125rem; margin-bottom: 1.5rem;">
						<strong>{indicador.valor}</strong> {indicador.unidad || ''}
					</p>

					<h3 style="margin-bottom: 0.5rem; color: #666; font-size: 0.875rem; text-transform: uppercase;">Fecha</h3>
					<p style="font-size: 1.125rem; margin-bottom: 1.5rem;">
						{new Date(indicador.fecha).toLocaleDateString('es-ES', { 
							year: 'numeric', 
							month: 'long', 
							day: 'numeric' 
						})}
					</p>

					{indicador.descripcion && (
						<>
							<h3 style="margin-bottom: 0.5rem; color: #666; font-size: 0.875rem; text-transform: uppercase;">Descripción</h3>
							<p style="font-size: 1rem; line-height: 1.6;">{indicador.descripcion}</p>
						</>
					)}
				</div>
			</div>

			<div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #dee2e6;">
				<button 
					id="delete-btn" 
					class="btn btn-danger"
					data-id={indicador.id}
				>
					Eliminar Indicador
				</button>
			</div>
		</div>
	)}
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const deleteBtn = document.getElementById('delete-btn');
		
		if (deleteBtn) {
			deleteBtn.addEventListener('click', async (e) => {
				const id = (e.target as HTMLButtonElement).dataset.id;
				
				if (!confirm('¿Estás seguro de que deseas eliminar este indicador? Esta acción no se puede deshacer.')) {
					return;
				}

				try {
					const response = await fetch(`http://localhost:5211/api/indicadores/${id}`, {
						method: 'DELETE'
					});

					if (response.ok) {
						alert('Indicador eliminado correctamente');
					window.location.href = '/indicadores';
					} else {
						alert('Error al eliminar el indicador');
					}
				} catch (error) {
					console.error(error);
					alert('Error al conectar con la API');
				}
			});
		}
	});
</script>
