---
import Layout from '../../../layouts/Layout.astro';
import { IndicadorApiService } from '../../../lib/api';

const { id } = Astro.params;

if (!id) {
	return Astro.redirect('/');
}

let indicador = null;
let error = '';

// Manejar POST para actualizar
if (Astro.request.method === 'POST') {
	try {
		const formData = await Astro.request.formData();
		
		const updatedIndicador = {
			id: parseInt(id),
			tipo: formData.get('tipo') as string,
			categoria: formData.get('categoria') as string,
			nombre: formData.get('nombre') as string,
			descripcion: formData.get('descripcion') as string,
			valor: formData.get('valor') as string,
			unidad: formData.get('unidad') as string,
			fecha: formData.get('fecha') as string,
			ambito: formData.get('ambito') as string,
		};

		const response = await fetch(`http://localhost:5211/api/indicadores/${id}`, {
			method: 'PUT',
			headers: {
				'Content-Type': 'application/json',
			},
			body: JSON.stringify(updatedIndicador),
		});

		if (response.ok) {
			return Astro.redirect('/indicadores?success=updated');
		} else {
			error = 'Error al actualizar el indicador';
		}
	} catch (e) {
		console.error(e);
		error = 'Error al conectar con la API';
	}
}

try {
	indicador = await IndicadorApiService.getByIdAsync(parseInt(id));
	
	if (!indicador) {
		return Astro.redirect('/indicadores?error=not-found');
	}
} catch (e) {
	console.error(e);
	error = 'Error al cargar el indicador';
}

const fechaFormateada = indicador ? new Date(indicador.fecha).toISOString().split('T')[0] : '';
---

<Layout title="Editar Indicador">
	<div class="card">
		<h2>Editar Indicador #{id}</h2>
		
		{error && (
			<div class="alert alert-error">
				{error}
			</div>
		)}

		{indicador && (
			<form method="POST">
				<div class="form-group">
					<label for="tipo">Tipo *</label>
					<select name="tipo" id="tipo" required>
						<option value="">Seleccionar...</option>
						<option value="Económico" selected={indicador.tipo === 'Económico'}>Económico</option>
						<option value="Social" selected={indicador.tipo === 'Social'}>Social</option>
						<option value="Ambiental" selected={indicador.tipo === 'Ambiental'}>Ambiental</option>
						<option value="Tecnológico" selected={indicador.tipo === 'Tecnológico'}>Tecnológico</option>
					</select>
				</div>

				<div class="form-group">
					<label for="categoria">Categoría *</label>
					<input type="text" name="categoria" id="categoria" value={indicador.categoria} required />
				</div>

				<div class="form-group">
					<label for="nombre">Nombre *</label>
					<input type="text" name="nombre" id="nombre" value={indicador.nombre} required />
				</div>

				<div class="form-group">
					<label for="descripcion">Descripción</label>
					<textarea name="descripcion" id="descripcion" rows="3">{indicador.descripcion}</textarea>
				</div>

				<div class="form-group">
					<label for="valor">Valor *</label>
					<input type="text" name="valor" id="valor" value={indicador.valor} required />
				</div>

				<div class="form-group">
					<label for="unidad">Unidad</label>
					<input type="text" name="unidad" id="unidad" value={indicador.unidad || ''} placeholder="ej: %, kg, €, etc." />
				</div>

				<div class="form-group">
					<label for="fecha">Fecha *</label>
					<input type="date" name="fecha" id="fecha" value={fechaFormateada} required />
				</div>

				<div class="form-group">
					<label for="ambito">Ámbito *</label>
					<select name="ambito" id="ambito" required>
						<option value="">Seleccionar...</option>
						<option value="Nacional" selected={indicador.ambito === 'Nacional'}>Nacional</option>
						<option value="Regional" selected={indicador.ambito === 'Regional'}>Regional</option>
						<option value="Local" selected={indicador.ambito === 'Local'}>Local</option>
						<option value="Global" selected={indicador.ambito === 'Global'}>Global</option>
					</select>
				</div>

				<div class="actions" style="margin-top: 1.5rem;">
					<button type="submit" class="btn btn-success">Guardar Cambios</button>
				<a href="/indicadores" class="btn btn-secondary">Cancelar</a>
				</div>
			</form>
		)}
	</div>
</Layout>
