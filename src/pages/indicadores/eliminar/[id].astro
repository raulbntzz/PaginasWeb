---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { IndicadorApiService } from '../../../lib/api';

const { id } = Astro.params;

if (!id) return Astro.redirect('/indicadores');

let indicador = null;
let error = '';

if (Astro.request.method === 'POST') {
  try {
    const response = await fetch(`http://localhost:5211/api/indicadores/${id}`, {
      method: 'DELETE',
    });

    if (response.ok) {
      return Astro.redirect('/indicadores?success=deleted');
    } else if (response.status === 404) {
      return Astro.redirect('/indicadores?error=not-found');
    } else {
      error = 'No se pudo eliminar el indicador. Inténtalo de nuevo.';
    }
  } catch (e) {
    console.error(e);
    error = 'Error al conectar con la API';
  }
}

try {
  indicador = await IndicadorApiService.getByIdAsync(Number(id));
  if (!indicador) return Astro.redirect('/indicadores?error=not-found');
} catch (e) {
  console.error(e);
  error = 'Error al cargar el indicador';
}
---

<Layout title="Eliminar Indicador">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 mb-0">Eliminar Indicador #{id}</h2>
          </div>

          {error && (
            <div class="alert alert-danger alert-dismissible fade show">
              <strong>Error:</strong> {error}
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          )}

          {indicador && (
            <>
              <div class="row g-3 mb-4">
                <div class="col-md-6">
                  <label class="text-uppercase small text-muted fw-bold">Nombre</label>
                  <p class="fs-5 fw-bold mb-3">{indicador.nombre}</p>

                  <label class="text-uppercase small text-muted fw-bold">Tipo</label>
                  <p class="fs-5 mb-3">{indicador.tipo}</p>
                </div>

                <div class="col-md-6">
                  <label class="text-uppercase small text-muted fw-bold">Ámbito</label>
                  <p class="fs-5 mb-3">{indicador.ambito}</p>

                  <label class="text-uppercase small text-muted fw-bold">Fecha</label>
                  <p class="fs-5 mb-0">{new Date(indicador.fecha).toLocaleDateString('es-ES')}</p>
                </div>
              </div>

              <form method="POST">
                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-danger">
                    Eliminar
                  </button>
                  <a href={`../../indicadores`} class="btn btn-outline-secondary">
                    Cancelar
                  </a>
                </div>
              </form>
            </>
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>
